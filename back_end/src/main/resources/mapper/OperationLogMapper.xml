<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zaowuji.back.mapper.OperationLogMapper">

    <insert id="insert" parameterType="com.zaowuji.back.entity.OperationLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO operation_log (admin_id, action, detail, ip)
        VALUES (#{adminId}, #{action}, #{detail}, #{ip})
    </insert>

</mapper>
