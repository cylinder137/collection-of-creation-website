<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zaowuji.back.mapper.DeviceMapper">

    <sql id="allColumns">
        id, machine_code, product_id, order_id, user_id, created_at, updated_at
    </sql>

    <select id="selectByMachineCode" resultType="com.zaowuji.back.entity.Device">
        SELECT <include refid="allColumns"/>
        FROM device
        WHERE machine_code = #{machineCode}
    </select>

    <insert id="insert" parameterType="com.zaowuji.back.entity.Device"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO device (machine_code, product_id, order_id, user_id)
        VALUES (#{machineCode}, #{productId}, #{orderId}, #{userId})
    </insert>

</mapper>
