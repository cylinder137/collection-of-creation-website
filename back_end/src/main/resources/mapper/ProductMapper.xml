<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zaowuji.back.mapper.ProductMapper">

    <sql id="allColumns">
        id, name, code, description, price, version, cover_url, status, sort, created_at, updated_at
    </sql>

    <select id="selectOnSale" resultType="com.zaowuji.back.entity.Product">
        SELECT <include refid="allColumns"/>
        FROM product
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectById" resultType="com.zaowuji.back.entity.Product">
        SELECT <include refid="allColumns"/>
        FROM product
        WHERE id = #{id}
    </select>

    <select id="selectByCode" resultType="com.zaowuji.back.entity.Product">
        SELECT <include refid="allColumns"/>
        FROM product
        WHERE code = #{code}
    </select>

</mapper>
