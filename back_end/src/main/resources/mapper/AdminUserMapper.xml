<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zaowuji.back.mapper.AdminUserMapper">

    <sql id="allColumns">
        id, username, password, nickname, role, status, last_login_at, created_at, updated_at
    </sql>

    <select id="selectByUsername" resultType="com.zaowuji.back.entity.AdminUser">
        SELECT <include refid="allColumns"/>
        FROM admin_user
        WHERE username = #{username}
    </select>

    <select id="selectById" resultType="com.zaowuji.back.entity.AdminUser">
        SELECT <include refid="allColumns"/>
        FROM admin_user
        WHERE id = #{id}
    </select>

</mapper>
